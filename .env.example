# Frontend Configuration
FRONTEND_PORT=3000

# Backend API URL
# Development: Use the full URL to the backend service
# Production: Use relative URL if using nginx reverse proxy (e.g., /api)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Brand Configuration
NEXT_PUBLIC_BRAND_NAME=Miniatures.lk
NEXT_PUBLIC_PRIMARY_COLOR=#C9A66B
NEXT_PUBLIC_SECONDARY_COLOR=#EBD3A0
NEXT_PUBLIC_DARK_COLOR=#2F2F2F

# Production Web Server (for docker-compose.prod.yml)
HTTP_PORT=80
HTTPS_PORT=443
